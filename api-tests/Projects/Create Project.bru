meta {
  name: Create Project
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: none
}

body:json {
  {
    "projectName": "My First Project"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("projectId", res.body.id);
  }
}
