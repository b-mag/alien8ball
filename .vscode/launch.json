{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug QuestionCanvas.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/EnterpriseQuestionCanvas/backend/src/QuestionCanvas.Api/bin/Debug/net10.0/QuestionCanvas.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/EnterpriseQuestionCanvas/backend/src/QuestionCanvas.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7043;http://localhost:5043"
            }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "start-frontend",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/EnterpriseQuestionCanvas/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (API + Frontend)",
            "configurations": [
                "Debug QuestionCanvas.Api",
                "Debug Frontend (Chrome)"
            ],
            "stopAll": true
        }
    ]
}